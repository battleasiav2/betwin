<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@null</item>
    </style>
    <style name="NumKey" parent="Key">
        <item name="android:background">@drawable/bg_num</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="OpKey" parent="Key">
        <item name="android:background">@drawable/bg_op</item>
        <item name="android:textColor">@color/op_text</item>
    </style>
    <style name="EqKey" parent="Key">
        <item name="android:background">@drawable/bg_eq</item>
        <item name="android:textColor">@color/op_text</item>
    </style>
</resources>
